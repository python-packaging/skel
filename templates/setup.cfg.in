[check]
metadata = true
strict = true

[coverage:run]
branch = True
source = {package},tests

[coverage:report]
fail_under = 70
precision = 1
show_missing = True
skip_covered = True

[mypy]
ignore_missing_imports = True

[tox:tox]
envlist = py{@310,311,312,313,314}, coverage

[testenv]
deps = .[test]
commands =
    coverage run -m pytest
setenv =
    COVERAGE_FILE={@toxworkdir}/.coverage.{@envname}

[testenv:coverage]
deps = coverage
setenv =
    COVERAGE_FILE={@toxworkdir}/.coverage
commands =
    coverage combine
    coverage report
depends =
    py{@10,311,312,313,314}

